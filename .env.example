# Copy to .env and fill in. NEVER commit .env.
# --- LINE (LINE Developers > your channel) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Providers: fake = offline & free. Switch to real ones when ready. ---
LLM_PROVIDER=fake          # fake | gemini
PLACES_PROVIDER=fake       # fake | google
STORE_PROVIDER=memory      # memory | dynamo
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Google (Google Cloud console) ---
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=

# PRIVACY: set true ONLY after billing is enabled on the Gemini project (paid tier
# does not use prompts for training). If not true, the bot will NOT read group chat.
GEMINI_PAID_TIER_CONFIRMED=false

# --- Budget caps ---
BOT_ENABLED=true                     # kill switch
SESSION_MINUTES=60
MAX_LLM_CALLS_PER_SESSION=40
MAX_SEARCHES_PER_GROUP_PER_DAY=10
MAX_PLACES_CALLS_PER_DAY=300
